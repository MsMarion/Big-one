__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
build/
# colcon (if ever built in-tree)
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
# editors / OS
.vscode/
.idea/
Thumbs.db

# downloaded third-party binaries (zenoh bridge, etc.)
tools_bin/
data/preview/
