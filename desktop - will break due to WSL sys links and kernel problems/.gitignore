data/calibration/

# fetched robot descriptions (robots/*/fetch_description.sh)
robots/*/description/

# written by bringup at runtime (on the Jetson /data is the repo's data/)
data/pnp_active_scene
data/pnp_active_joint_offsets

# rendered DINO templates (tools/render_templates.py): regenerable
data/templates/
# vision model weights (tools/stage_vision_models.sh)
models/vision/
