<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile for ROS nodes INSIDE the pnp container (set by setup/ros_env.sh).
  Why: camera images are ~1 MB, i.e. ~16 UDP fragments each. With the Linux default socket
  buffers (~208 KB) a burst overflows the receive buffer, one fragment is lost and the whole
  image is dropped (best-effort sensor QoS). Large UDP buffers fix it; shared memory is kept
  for node-to-node traffic inside the container.
  Requires net.core.rmem_max / wmem_max >= these sizes on the WSL host (setup/wsl_host_setup.sh).
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_big_buffers</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>33554432</sendBufferSize>
        <receiveBufferSize>33554432</receiveBufferSize>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>shm</transport_id>
        <type>SHM</type>
        <segment_size>67108864</segment_size>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="pnp_container" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>shm</transport_id>
          <transport_id>udp_big_buffers</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
